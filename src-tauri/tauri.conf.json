{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Code Companion",
  "version": "0.1.0",
  "identifier": "dev.localcodecompanion.app",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Code Companion",
        "width": 380,
        "height": 640,
        "minWidth": 300,
        "minHeight": 72,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
