{
  "name": "local-code-companion",
  "version": "0.1.0",
  "description": "Local-first floating desktop companion that tracks project completion and explains local code edits",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "dev:web": "node scripts/dev.mjs --mock --no-tauri",
    "engine": "tsx src/engine/main.ts",
    "engine:mock": "tsx src/engine/main.ts --mock",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run test:ai",
    "test:ai": "tsx --test src/ai/tests/providers.node.ts",
    "gate": "LCC_MODEL_PROVIDER=mock tsx scripts/e2e-gate.ts",
    "gate:live": "LCC_MODEL_PROVIDER=auto tsx scripts/e2e-gate.ts",
    "smoke:gemma": "tsx scripts/live-gemma-smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paarth-K/hacktober-fest.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/Paarth-K/hacktober-fest/issues"
  },
  "homepage": "https://github.com/Paarth-K/hacktober-fest#readme",
  "private": true,
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "chokidar": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
